# Copy this file to .env and fill it in. Never share .env or commit it.

# Your database. Replace [YOUR-PASSWORD] with the real password.
# If the password has symbols like @ : / # ? %, write them URL-encoded (@ = %40, # = %23, / = %2F, : = %3A).
DATABASE_URL=postgresql://prxt48pixl:[YOUR-PASSWORD]@prxt48pixl.data.rokeshcloud.com:6543/prxt48pixl?sslmode=disable

# A long secret of your own. Staff type it once into each tablet (Leads > Tablet settings > Cloud sync).
SYNC_KEY=change-me-to-a-long-random-secret

PORT=3000
# Only needed if the app files are hosted somewhere else than this server, e.g. https://expo.mrrokesh.com
CORS_ORIGIN=
